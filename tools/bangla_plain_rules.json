{
  "version": 1,
  "about": "Rules for tools/bangla_plain_apply.mjs. Binding source: docs/design/bangla-plain-final-decision.md. Word rules run first (in order), then per-key rewrites of the same group. Edits touch Bangla string values only.",
  "groups": ["spelling", "meaning", "stiff"],
  "protected": {
    "about": "Protected strings accept only the 'spelling' group (plus rules/rewrites marked allowProtected). Keys are packs.ts keys (regex). contentRegex matches any string, in any file.",
