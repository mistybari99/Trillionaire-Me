      "^advice\\.(note|draft)$", "^next\\.note$", "^fit\\.(draft|w\\.note)$", "^overall\\.note$", "^intake\\.skipHint$", "^home\\.cnt\\.unknown$", "^unknown\\.",
      "^stage\\.leftNote$", "^reality\\.note$", "^reward\\.", "^goal\\.status\\.note$", "^team\\.err\\.contact$", "^lock\\.", "^privacy\\.", "^conn\\.", "^enc\\.wroteNeed$",
      "^rl\\.impact\\.rule$"
    ],
    "files": ["src/library/halalFlags.ts", "public/content/pack-003.json", "public/content/pack-009.json"],
